# Which packages this machine stows; see the Makefile.
packages.local

# Machine-local: which plugins and marketplaces this machine enables.
# Bootstrap from agent-suite/platforms/claude/settings.json.example — see its README.
claude/.claude/settings.json

# zsh secrets and machine-local overrides belong only in ~; guard against creating them in the package.
.zsh_secrets
.zshrc.local
.zshenv.local

# Project-local agent state (agent memory, worktrees).
.claude/
