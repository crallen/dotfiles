[Unit]
Description=T3 Code Server
# t3@latest is resolved from the npm registry on every start, so the network
# has to be up before ExecStart runs. `After=` alone does not pull the target in.
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
ExecStart=%h/.local/bin/t3-serve
Restart=on-failure
# Without a delay, a failed registry lookup would restart in a tight loop.
RestartSec=5

[Install]
WantedBy=default.target
