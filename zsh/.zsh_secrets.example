# ~/.zsh_secrets: per-machine secrets, never committed.
#
# - Keep this file mode 600 (chmod 600 ~/.zsh_secrets); with any wider mode,
#   .zshrc refuses to source it.
# - Only interactive shells load it; cron, systemd, and `ssh host cmd` never see
#   these values.
# - Every exported value reaches all child processes of an interactive shell,
#   including agent-spawned shells. Keep high-value, project-scoped tokens in a
#   gitignored .envrc or a password manager instead.
# - When typing a secret at the prompt, prefix the command with a space to keep
#   it out of history.
#
# Uncomment and fill in what this machine needs:

# export GITHUB_TOKEN=replace-with-github-token
# export OPENAI_API_KEY=replace-with-openai-key
# export ANTHROPIC_API_KEY=replace-with-anthropic-key
